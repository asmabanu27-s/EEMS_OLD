  paths: {
    "/api/health": {
      get: {
        tags: ["Health"],

        summary:
          "Health check",

        responses: {
          "200": {
            description:
              "API is healthy",
          },
        },
      },
    },

    "/api/auth/login": {
      post: {
        tags: [
          "Authentication",
        ],

        summary: "Login",

        description:
          "Authenticate using username, email, or employee code.",

        requestBody: {
          required: true,

          content: {
            "application/json": {
              schema: {
                $ref:
                  "#/components/schemas/LoginRequest",
              },
            },
          },
        },

        responses: {
          "200": {
            description:
              "Authentication successful",

            content: {
              "application/json": {
                schema: {
                  $ref:
                    "#/components/schemas/LoginResponse",
                },
              },
            },
          },

          "400": {
            description:
              "Invalid request",
          },

          "401": {
            description:
              "Invalid credentials",
          },

          "403": {
            description:
              "Account inactive or locked",
          },
        },
      },
    },

    "/api/employees": {
      get: {
        tags: ["Employees"],

        summary:
          "List employees",

        security: [
          {
            bearerAuth: [],
          },
        ],

        responses: {
          "200": {
            description:
              "Employees visible to the authenticated user",
          },

          "401": {
            description:
              "Authentication required",
          },

          "403": {
            description:
              "Insufficient permission",
          },
        },
      },

      post: {
        tags: ["Employees"],

        summary:
          "Create employee",

        security: [
          {
            bearerAuth: [],
          },
        ],

        requestBody: {
          required: true,

          content: {
            "application/json": {
              schema: {
                $ref:
                  "#/components/schemas/EmployeeCreateRequest",
              },
            },
          },
        },

        responses: {
          "201": {
            description:
              "Employee created",
          },

          "400": {
            description:
              "Validation error",
          },

          "401": {
            description:
              "Authentication required",
          },

          "403": {
            description:
              "Insufficient permission or scope",
          },

          "409": {
            description:
              "Employee code already exists",
          },
        },
      },
    },

    "/api/employees/{id}": {
      parameters: [
        {
          name: "id",

          in: "path",

          required: true,

          description:
            "Employee UUID",

          schema: {
            type: "string",
            format: "uuid",
          },
        },
      ],

      get: {
        tags: ["Employees"],

        summary:
          "Get employee",

        security: [
          {
            bearerAuth: [],
          },
        ],

        responses: {
          "200": {
            description:
              "Employee details",
          },

          "401": {
            description:
              "Authentication required",
          },

          "403": {
            description:
              "Employee outside allowed scope",
          },

          "404": {
            description:
              "Employee not found",
          },
        },
      },

      patch: {
        tags: ["Employees"],

        summary:
          "Update employee",

        security: [
          {
            bearerAuth: [],
          },
        ],

        requestBody: {
          required: true,

          content: {
            "application/json": {
              schema: {
                $ref:
                  "#/components/schemas/EmployeeUpdateRequest",
              },
            },
          },
        },

        responses: {
          "200": {
            description:
              "Employee updated",
          },

          "400": {
            description:
              "Validation error",
          },

          "401": {
            description:
              "Authentication required",
          },

          "403": {
            description:
              "Insufficient permission or scope",
          },

          "404": {
            description:
              "Employee not found",
          },

          "409": {
            description:
              "Duplicate employee code",
          },
        },
      },

      delete: {
        tags: ["Employees"],

        summary:
          "Delete employee",

        security: [
          {
            bearerAuth: [],
          },
        ],

        responses: {
          "204": {
            description:
              "Employee deleted",
          },

          "401": {
            description:
              "Authentication required",
          },

          "403": {
            description:
              "Insufficient permission",
          },

          "404": {
            description:
              "Employee not found",
          },
        },
      },
    },

    "/api/attendance": {
      get: {
        tags: ["Attendance"],

        summary:
          "List attendance records",

        description:
          "Returns attendance records according to the authenticated user's organizational scope. ADMIN can view all records, MANAGER can view department records, TEAM_LEAD can view team records, and EMPLOYEE can view only their own records.",

        security: [
          {
            bearerAuth: [],
          },
        ],

        parameters: [
          {
            name: "employeeId",

            in: "query",

            required: false,

            description:
              "Employee UUID. EMPLOYEE users can only request their own employee ID. MANAGER users are restricted to their department. TEAM_LEAD users are restricted to their team. ADMIN users can request any employee.",

            schema: {
              type: "string",
              format: "uuid",
            },
          },

          {
            name: "status",

            in: "query",

            required: false,

            description:
              "Filter by attendance status.",

            schema: {
              type: "string",

              enum: [
                "PRESENT",
                "ABSENT",
                "LEAVE",
                "HOLIDAY",
                "WEEK_OFF",
              ],
            },
          },

          {
            name: "from",

            in: "query",

            required: false,

            description:
              "Start attendance date.",

            schema: {
              type: "string",

              format: "date",

              example:
                "2026-08-01",
            },
          },

          {
            name: "to",

            in: "query",

            required: false,

            description:
              "End attendance date.",

            schema: {
              type: "string",

              format: "date",

              example:
                "2026-08-31",
            },
          },

          {
            name: "page",

            in: "query",

            required: false,

            schema: {
              type: "integer",

              minimum: 1,

              default: 1,
            },
          },

          {
            name: "limit",

            in: "query",

            required: false,

            schema: {
              type: "integer",

              minimum: 1,

              maximum: 100,

              default: 20,
            },
          },
        ],

        responses: {
          "200": {
            description:
              "Attendance records returned successfully",

            content: {
              "application/json": {
                schema: {
                  $ref:
                    "#/components/schemas/AttendanceListResponse",
                },
              },
            },
          },

          "400": {
            description:
              "Invalid query parameter",
          },

          "401": {
            description:
              "Authentication required",
          },

          "403": {
            description:
              "Attendance outside the user's allowed organizational scope",
          },
        },
      },
    },

    "/api/attendance/{id}": {
      parameters: [
        {
          name: "id",

          in: "path",

          required: true,

          description:
            "Attendance record UUID",

          schema: {
            type: "string",

            format: "uuid",
          },
        },
      ],

      get: {
        tags: ["Attendance"],

        summary:
          "Get attendance record",

        description:
          "Returns one attendance record after applying resource-level authorization.",

        security: [
          {
            bearerAuth: [],
          },
        ],

        responses: {
          "200": {
            description:
              "Attendance record returned successfully",

            content: {
              "application/json": {
                schema: {
                  type: "object",

                  properties: {
                    success: {
                      type: "boolean",
                      example: true,
                    },

                    data: {
                      $ref:
                        "#/components/schemas/Attendance",
                    },
                  },
                },
              },
            },
          },

          "401": {
            description:
              "Authentication required",
          },

          "403": {
            description:
              "Attendance outside the user's allowed scope",
          },

          "404": {
            description:
              "Attendance record not found",
          },
        },
      },
    },

    "/api/attendance/today": {
