    "/api/timesheets": {
      get: {
        tags: ["Timesheets"],

        summary: "List timesheets",

        description:
          "Returns timesheets according to the authenticated user's organizational scope. Supported filters are employeeId, status, from, to, page and limit.",

        security: [
          {
            bearerAuth: [],
          },
        ],

        parameters: [
          {
            name: "employeeId",
            in: "query",
            required: false,
            description: "Employee UUID. Access is restricted by the authenticated user's scope.",
            schema: {
              type: "string",
              format: "uuid",
            },
          },
          {
            name: "status",
            in: "query",
            required: false,
            description: "Filter by timesheet workflow status.",
            schema: {
              type: "string",
              enum: [
                "DRAFT",
                "SUBMITTED",
                "APPROVED",
                "REJECTED",
              ],
            },
          },
          {
            name: "from",
            in: "query",
            required: false,
            description: "Start work date.",
            schema: {
              type: "string",
              format: "date",
              example: "2026-08-01",
            },
          },
          {
            name: "to",
            in: "query",
            required: false,
            description: "End work date.",
            schema: {
              type: "string",
              format: "date",
              example: "2026-08-31",
            },
          },
          {
            name: "page",
            in: "query",
            required: false,
            schema: {
              type: "integer",
              minimum: 1,
              default: 1,
            },
          },
          {
            name: "limit",
            in: "query",
            required: false,
            schema: {
              type: "integer",
              minimum: 1,
              maximum: 100,
              default: 20,
            },
          },
        ],

        responses: {
          "200": {
            description: "Timesheets returned successfully",
            content: {
              "application/json": {
                schema: {
                  $ref: "#/components/schemas/TimesheetListResponse",
                },
              },
            },
          },
          "400": {
            description: "Invalid query parameter",
          },
          "401": {
            description: "Authentication required",
          },
          "403": {
            description: "Insufficient permission or timesheet outside the user's allowed scope",
          },
        },
      },

      post: {
        tags: ["Timesheets"],

        summary: "Create timesheet",

        description:
          "Creates a timesheet for the authenticated employee. Employee identity is taken from the JWT and is not supplied by the request body.",

        security: [
          {
            bearerAuth: [],
          },
        ],

        requestBody: {
          required: true,
          content: {
            "application/json": {
              schema: {
                $ref: "#/components/schemas/TimesheetCreateRequest",
              },
            },
          },
        },

        responses: {
          "201": {
            description: "Timesheet created",
            content: {
              "application/json": {
                schema: {
                  $ref: "#/components/schemas/TimesheetResponse",
                },
              },
            },
          },
          "400": {
            description: "Validation error or invalid timesheet data",
          },
          "401": {
            description: "Authentication required",
          },
          "403": {
            description: "Authenticated user is not linked to an employee profile or insufficient permission",
          },
          "409": {
            description: "A timesheet already exists for the employee and work date",
          },
        },
      },
    },

    "/api/timesheets/export": {
      get: {
        tags: ["Timesheets"],

        summary: "Export timesheets",

        description:
          "Exports timesheets in XLSX or CSV format using the same filters as the timesheet list endpoint.",

        security: [
          {
            bearerAuth: [],
          },
        ],

        parameters: [
          {
            name: "format",
            in: "query",
            required: true,
            description: "Export file format.",
            schema: {
              type: "string",
              enum: ["xlsx", "csv"],
              default: "xlsx",
            },
          },
          {
            name: "employeeId",
            in: "query",
            required: false,
            schema: {
              type: "string",
              format: "uuid",
            },
          },
          {
            name: "status",
            in: "query",
            required: false,
            schema: {
              type: "string",
              enum: [
                "DRAFT",
                "SUBMITTED",
                "APPROVED",
                "REJECTED",
              ],
            },
          },
          {
            name: "from",
            in: "query",
            required: false,
            schema: {
              type: "string",
              format: "date",
              example: "2026-08-01",
            },
          },
          {
            name: "to",
            in: "query",
            required: false,
            schema: {
              type: "string",
              format: "date",
              example: "2026-08-31",
            },
          },
        ],

        responses: {
          "200": {
            description: "Timesheet export file",
            content: {
              "text/csv": {
                schema: {
                  type: "string",
                  format: "binary",
                },
              },
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                schema: {
                  type: "string",
                  format: "binary",
                },
              },
            },
          },
          "400": {
            description: "Invalid export format or query parameter",
          },
          "401": {
            description: "Authentication required",
          },
          "403": {
            description: "Insufficient export permission or timesheet outside the user's allowed scope",
          },
        },
      },
    },

   "/api/timesheets/{id}": {
  parameters: [
    {
      name: "id",
      in: "path",
      required: true,
      description: "Timesheet UUID",
      schema: {
        type: "string",
        format: "uuid",
      },
    },
  ],

  // ==========================================================================
  // GET TIMESHEET
  // ==========================================================================

  get: {
    tags: ["Timesheets"],

    summary: "Get timesheet by ID",

    description:
      "Returns one timesheet after applying resource-level authorization.",

    security: [
      {
        bearerAuth: [],
      },
    ],

    responses: {
      "200": {
        description: "Timesheet returned successfully",
        content: {
          "application/json": {
            schema: {
              $ref: "#/components/schemas/TimesheetResponse",
            },
          },
        },
      },
      "401": {
        description: "Authentication required",
      },
      "403": {
        description:
          "Insufficient permission or timesheet outside the user's allowed scope",
      },
      "404": {
        description: "Timesheet not found",
      },
    },
  },

  // ==========================================================================
  // UPDATE TIMESHEET
  // ==========================================================================

  patch: {
    tags: ["Timesheets"],

    summary: "Update timesheet",

    description:
      "Updates a timesheet owned by the authenticated employee. Updates are allowed only when the current timesheet status is DRAFT or REJECTED.",

    security: [
      {
        bearerAuth: [],
      },
    ],

    requestBody: {
      required: true,

      content: {
        "application/json": {
          schema: {
            $ref: "#/components/schemas/TimesheetUpdateRequest",
          },

          example: {
            workDate: "2026-08-15",
            firstCheckIn: "2026-08-15T09:00:00.000Z",
            lastCheckOut: "2026-08-15T18:00:00.000Z",
            workingMinutes: 540,
            notes: "Updated timesheet details",
          },
        },
      },
    },

    responses: {
      "200": {
        description: "Timesheet updated successfully",

        content: {
          "application/json": {
            schema: {
              $ref: "#/components/schemas/TimesheetResponse",
            },
          },
        },
      },

      "400": {
        description:
          "Invalid timesheet data or invalid status transition",
      },

      "401": {
        description: "Authentication required",
      },

      "403": {
        description:
          "Insufficient permission or authenticated employee is not the owner of the timesheet",
      },

      "404": {
        description: "Timesheet not found",
      },

      "409": {
        description:
          "A timesheet already exists for the employee and work date",
      },
    },
  },
},

